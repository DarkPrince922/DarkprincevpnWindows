<Window x:Class="DarkPrinceVpn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DarkPrinceVpn.Ui"
        Title="DarkPrince VPN" Height="720" Width="470"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <ui:AnimatedBackground>

        <!-- ================= ВХОД ================= -->
        <ScrollViewer x:Name="LoginPanel" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28" VerticalAlignment="Center">
                <Image x:Name="LogoImage" Width="120" Height="120" />
                <TextBlock x:Name="LoginTitle" Text="Вход" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,16,0,20" />

                <Button x:Name="TelegramButton" Content="Войти через Telegram"
                        Click="OnTelegramLogin" Height="42" />
                <TextBlock Text="Подойдёт, если вы уже пользовались нашим ботом — подписка и баланс подтянутся сами."
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,8,2,18" />

                <TextBlock Style="{StaticResource SectionHeader}" Text="ПОЧТА" />
                <TextBox x:Name="EmailBox" Height="34" VerticalContentAlignment="Center" />
                <TextBlock Text="E-mail" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10" Margin="2,2,0,8" />
                <PasswordBox x:Name="PasswordBox" Height="34" VerticalContentAlignment="Center"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource OutlineBrush}" Padding="8,6" />
                <TextBlock Text="Пароль" Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10" Margin="2,2,0,8" />
                <TextBox x:Name="ReferralBox" Height="34" VerticalContentAlignment="Center"
                         Visibility="Collapsed" />
                <TextBlock x:Name="ReferralLabel" Text="Реферальный код (необязательно)"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="10"
                           Margin="2,2,0,8" Visibility="Collapsed" />

                <Button x:Name="EmailButton" Content="Войти" Click="OnEmailSubmit" Height="40" />
                <Button x:Name="ToggleRegisterButton" Content="Нет аккаунта? Зарегистрируйтесь"
                        Click="OnToggleRegister" Background="Transparent" BorderThickness="0"
                        Margin="0,6,0,0" />
                <Button x:Name="ForgotButton" Content="Забыли пароль?" Click="OnForgotPassword"
                        Background="Transparent" BorderThickness="0" />

                <TextBlock x:Name="LoginMessage" Foreground="{StaticResource GoldBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock x:Name="LoginError" Foreground="{StaticResource DangerBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ================= ОСНОВНОЕ ================= -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl x:Name="Tabs" Grid.Row="0" Background="Transparent"
                        BorderThickness="0" Margin="16,12,16,0">

                <!-- Главная -->
                <TabItem Header="Главная">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0">
                            <Grid Height="210">
                                <Ellipse x:Name="PowerRing" Width="176" Height="176"
                                         Stroke="{StaticResource OutlineBrush}" StrokeThickness="2"
                                         Fill="{StaticResource SurfaceBrush}" />
                                <Button x:Name="PowerButton" Width="176" Height="176"
                                        Background="Transparent"
                                        BorderThickness="0" Click="OnPowerClick">
                                    <TextBlock x:Name="PowerIcon" Text="⏻" FontSize="60"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Button>
                            </Grid>

                            <TextBlock x:Name="StateText" Text="Нажмите для подключения"
                                       HorizontalAlignment="Center" FontSize="15"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,16" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="РЕЖИМ" />
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <RadioButton x:Name="ModeProxy" GroupName="Mode" IsChecked="True"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Content="Системный прокси" />
                                    <TextBlock Text="Без прав администратора. Браузеры и большинство программ."
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="20,2,0,10" />
                                    <RadioButton x:Name="ModeTun" GroupName="Mode"
                                                 Foreground="{StaticResource TextBrush}"
                                                 Content="TUN — весь трафик" />
                                    <TextBlock Text="Перехватывает трафик всех программ. Нужен запуск от администратора."
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="20,2,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="ТЕКУЩАЯ ПОДПИСКА" />
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14">
                                <StackPanel>
                                    <ComboBox x:Name="SubscriptionPicker" Visibility="Collapsed"
                                              Margin="0,0,0,10"
                                              SelectionChanged="OnSubscriptionChanged"
                                              DisplayMemberPath="DisplayName" />
                                    <TextBlock x:Name="SubscriptionTitle" Text="Подписка"
                                               FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SubscriptionDetails" Margin="0,6,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedServerText" Margin="0,10,0,0"
                                               FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="HomeError" Foreground="{StaticResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,10,0,20" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Серверы -->
                <TabItem Header="Серверы">
                    <Grid Margin="0,12,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Обновить список" Click="OnRefreshServers"
                                HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <ListBox Grid.Row="1" x:Name="ServerList"
                                 Background="{StaticResource SurfaceBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                                 SelectionChanged="OnServerSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <TextBlock Text="{Binding Name}" FontSize="13" />
                                        <TextBlock Text="{Binding TransportLabel}" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- Тарифы -->
                <TabItem Header="Тарифы">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PlansPanel" Margin="0,12,0,12" />
                    </ScrollViewer>
                </TabItem>

                <!-- Баланс -->
                <TabItem Header="Баланс">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="НА СЧЕТУ" />
                            <TextBlock x:Name="BalanceText" Text="—" FontSize="28"
                                       FontWeight="Bold" Foreground="{StaticResource GoldBrush}"
                                       Margin="0,0,0,16" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="ПРОМОКОД" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="PromoBox" Height="34"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Content="Применить" Margin="8,0,0,0"
                                        Click="OnApplyPromo" />
                            </Grid>

                            <Button Content="Пополнить в кабинете" Click="OnOpenCabinet" />
                            <TextBlock x:Name="BalanceMessage" Margin="0,10,0,0" FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Ещё -->
                <TabItem Header="Ещё">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Style="{StaticResource SectionHeader}" Text="АККАУНТ" />
                            <TextBlock x:Name="AccountText" FontSize="14" Margin="0,0,0,16" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="УСТРОЙСТВА" />
                            <ListBox x:Name="DeviceList" Height="150" Margin="0,0,0,8"
                                     Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Text="{Binding Title}" FontSize="13" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Отключить выбранное устройство" Click="OnDeleteDevice"
                                    Margin="0,0,0,16" />

                            <TextBlock Style="{StaticResource SectionHeader}" Text="ПРИГЛАСИТЬ ДРУГА" />
                            <TextBlock x:Name="ReferralText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" />

                            <Button Content="Выйти из аккаунта" Click="OnLogout"
                                    BorderBrush="{StaticResource DangerBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="1" x:Name="StatusBar" Margin="16,6,16,10" FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
        </Grid>
    </ui:AnimatedBackground>
</Window>
